# Server only. Never paste keys into tickets or frontend config.
CODEX_API_KEY=
# OPENAI_API_KEY is also accepted for Codex.
ANTHROPIC_API_KEY=
# Colon-separated absolute repository roots on macOS/Linux.
SWIMLANE_WORKSPACE_ROOTS=/Users/you/Code
SWIMLANE_RUN_TIMEOUT=600
# Optional: defaults to backend/.swimlane (retain worktrees for review).
# SWIMLANE_ARTIFACTS=/Users/you/.swimlane/runs
